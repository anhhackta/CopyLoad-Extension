{
  "manifest_version": 3,
  "name": "CopyLoad",
  "version": "1.0.2",
  "description": "Clipboard history manager: save text and images, search, pin, paste from history, PIN lock.",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "side_panel": {
    "default_path": "src/app/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/settings.js",
        "src/content/picker.js",
        "src/content/note.js",
        "src/content/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "CopyLoad",
    "default_popup": "src/app/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}